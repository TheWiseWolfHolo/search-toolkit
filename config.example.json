{
  "version": 2,
  "statePath": "C:/Users/you/.config/search-toolkit/state.db",
  "profile": "full",
  "shaping": { "maxDescriptionChars": 700, "maxParamDescriptionChars": 220 },
  "providers": {
    "exa": {
      "enabled": true,
      "auto": ["search", "images", "fetch"],
      "keys": ["replace-me"],
      "integration": {
        "kind": "remote_mcp",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "auth": { "kind": "header", "name": "x-api-key" }
      }
    },
    "tavily": {
      "enabled": true,
      "auto": ["search", "images", "fetch"],
      "keys": ["replace-me"],
      "integration": {
        "kind": "remote_mcp",
        "url": "https://mcp.tavily.com/mcp/",
        "auth": { "kind": "query", "name": "tavilyApiKey" }
      }
    },
    "linkup": {
      "enabled": true,
      "auto": [],
      "keys": ["replace-me"],
      "integration": {
        "kind": "remote_mcp",
        "url": "https://mcp.linkup.so/mcp",
        "auth": { "kind": "bearer" }
      }
    },
    "anysearch": {
      "enabled": true,
      "auto": [],
      "keys": ["replace-me"],
      "integration": {
        "kind": "remote_mcp",
        "url": "https://api.anysearch.com/mcp",
        "auth": { "kind": "bearer" }
      },
      "toolPolicy": {
        "descriptions": {
          "search": "General and vertical web search. Pass only query for general search. To use domain/sub_domain, call get_sub_domains first and obey the parameter schema it returns; never guess domain values."
        }
      }
    },
    "firecrawl": {
      "enabled": true,
      "auto": ["fetch"],
      "keys": ["replace-me"],
      "integration": {
        "kind": "stdio_mcp",
        "command": "npx",
        "args": ["-y", "firecrawl-mcp@3.24.0"],
        "envKey": "FIRECRAWL_API_KEY"
      },
      "toolPolicy": {
        "allow": [
          "firecrawl_scrape",
          "firecrawl_map",
          "firecrawl_search",
          "firecrawl_crawl",
          "firecrawl_check_crawl_status",
          "firecrawl_developer_search",
          "firecrawl_research_search_github"
        ]
      }
    },
    "querit": {
      "enabled": true,
      "auto": ["search"],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "querit" }
    },
    "serper": {
      "enabled": true,
      "auto": ["search", "images"],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "serper" }
    },
    "brave": {
      "enabled": true,
      "auto": ["search", "images"],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "brave" }
    },
    "you": {
      "enabled": true,
      "auto": ["search"],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "you" }
    },
    "parallel": {
      "enabled": true,
      "auto": ["search"],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "parallel" }
    },
    "grok": {
      "enabled": true,
      "auto": [],
      "keys": ["replace-me"],
      "integration": {
        "kind": "rest",
        "adapter": "grok",
        "baseUrl": "https://api.x.ai/v1/responses"
      },
      "options": {
        "model": "grok-4.6",
        "reasoningEffort": "low",
        "systemPrompt": "Search the web and answer concisely with citations."
      }
    },
    "doubao": {
      "enabled": true,
      "auto": [],
      "keys": ["replace-me"],
      "integration": { "kind": "rest", "adapter": "doubao" }
    }
  }
}
